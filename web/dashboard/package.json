{
  "name": "sovereign-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Madi — Korea-friendly live transcription dashboard (scaffold)",
  "scripts": {
    "sync:fixtures": "mkdir -p public/fixtures && cp ../fixtures/*.jsonl public/fixtures/",
    "predev": "npm run sync:fixtures",
    "prebuild": "npm run sync:fixtures",
    "dev": "vite",
    "lint": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
