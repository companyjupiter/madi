<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone capture (AVAudioEngine) -->
  <key>com.apple.security.device.audio-input</key> <true/>

  <!-- Read the user's local Calendar (EventKit) to prefill meeting title/attendees -->
  <key>com.apple.security.personal-information.calendars</key> <true/>

  <!-- NOT sandboxed: Developer ID DMG distribution; we spawn the engine binary
       and read/write temp segment files. (Mac App Store would require
       App Sandbox + a redesign, see DESIGN.md section 9.) Until then,
       EnginePathPolicy constrains live STREAM wav jobs to app-owned temp roots
       and passes the same roots to the engine via STREAM_WAV_ROOTS.
       Hardened Runtime is enabled via the codesign runtime option, not here.
       The engine child process is a separate Mach-O signed with the same
       Developer ID + runtime; no JIT entitlement is needed unless a future
       kernel path requires it (measure first). -->
</dict>
</plist>
