<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>            <string>Madi</string>
  <key>CFBundleDisplayName</key>     <string>Madi</string>
  <key>CFBundleIdentifier</key>      <string>com.companyjupiter.madi</string>
  <key>CFBundleVersion</key>         <string>1</string>
  <key>CFBundleShortVersionString</key> <string>0.1.0</string>
  <!-- Full semantic version incl. prerelease (source of truth mirrored by
       AppInfo/AppVersion.swift). CFBundleShortVersionString stays numeric-only
       as macOS requires; a -beta.N prerelease (beta channel only) would live here. -->
  <key>MADIFullVersion</key>         <string>0.1.0</string>
  <key>MADIChannel</key>             <string>stable</string>
  <!-- Stable channel: no MADIBetaExpiry → BetaGate stays .active (no expiry
       block / warning banner). A beta build re-adds MADIChannel=beta + MADIBetaExpiry. -->
  <key>CFBundlePackageType</key>     <string>APPL</string>
  <key>CFBundleExecutable</key>      <string>Madi</string>
  <key>CFBundleIconFile</key>        <string>AppIcon</string>
  <key>LSMinimumSystemVersion</key>  <string>14.0</string>
  <!-- arm64-only (M1+); Metal-4 kernels auto-fall back to MPS on older OS -->
  <key>LSRequiresNativeExecution</key> <true/>
  <key>LSApplicationCategoryType</key> <string>public.app-category.productivity</string>

  <!-- Microphone permission rationale (required or capture crashes) -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Madi transcribes your meetings on-device. Audio never leaves your Mac.</string>

  <!-- Calendar: read the current event to prefill meeting title + attendees (local, read-only) -->
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Madi reads the meeting happening now to prefill its title and attendees. Your calendar stays on your Mac.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>Madi reads the meeting happening now to prefill its title and attendees. Your calendar stays on your Mac.</string>

  <key>NSHighResolutionCapable</key> <true/>
</dict>
</plist>
