{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Madi UI Parity",
  "version": "0.1.0",
  "identifier": "tv.devart.madi.parity",
  "build": {
    "beforeDevCommand": "npm run prepare-native && npm run dev",
    "beforeBuildCommand": "npm run prepare-native && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Madi UI Parity",
      "width": 1150,
      "height": 710,
      "minWidth": 980,
      "minHeight": 640,
      "center": true,
      "visible": false,
      "resizable": true,
      "titleBarStyle": "Transparent",
      "hiddenTitle": true,
      "backgroundColor": "#ffffff"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../macos/Sovereign/Resources/AppIcon.icns", "../../macos/Sovereign/Resources/icon_app_madi.png", "icons/icon.ico"]
  }
}
