{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local parity window with native model installation, media selection, transcription, workspace scanning, isolated settings, archive opening and confirmed native exports. Paths are native-owned; capture follows native permission preflight; no arbitrary path/URL, shell, filesystem plugin or remote-origin grants.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-review-command",
    "allow-playback-snapshot",
    "allow-playback-toggle",
    "allow-caption-status",
    "allow-caption-toggle",
    "allow-preferences-snapshot",
    "allow-preferences-command",
    "allow-settings-command",
    "allow-glossary-snapshot",
    "allow-glossary-command",
    "allow-setup-snapshot",
    "allow-setup-command",
    "allow-audio-inputs",
    "allow-choose-file",
    "allow-models-snapshot",
    "allow-models-command",
    "allow-models-artwork",
    "allow-file-snapshot",
    "allow-file-artwork",
    "allow-file-start",
    "allow-file-leave",
    "allow-live-start",
    "allow-live-control",
    "allow-live-permission-action",
    "allow-file-reset",
    "allow-file-edit",
    "allow-file-copy-line",
    "allow-file-rename-speaker",
    "allow-workspace-snapshot",
    "allow-workspace-command",
    "allow-workspace-choose-folder",
    "allow-workspace-open",
    "allow-workspace-export",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-settings-open",
    "allow-settings-metadata",
    "allow-settings-model-locations",
    "allow-settings-models-command",
    "allow-settings-reveal"
  ]
}
