{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local parity window with native model installation, media selection, transcription, workspace scanning, isolated settings, archive opening and confirmed native exports. Paths are native-owned; no arbitrary path/URL, capture, shell, filesystem plugin or remote-origin grants.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-setup-snapshot",
    "allow-setup-command",
    "allow-audio-inputs",
    "allow-choose-file",
    "allow-models-snapshot",
    "allow-models-command",
    "allow-models-artwork",
    "allow-file-snapshot",
    "allow-file-artwork",
    "allow-file-start",
    "allow-file-reset",
    "allow-file-edit",
    "allow-file-copy-line",
    "allow-file-rename-speaker",
    "allow-workspace-snapshot",
    "allow-workspace-command",
    "allow-workspace-choose-folder",
    "allow-workspace-open",
    "allow-workspace-export",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
