# Binary model data + generated assets are NOT committed.
*.safetensors
*.bin
*.wav
*.npz

# ── Model-asset folder: keep only generator scripts + docs ───────
metal/assets/*
!metal/assets/gen_assets.py
!metal/assets/export_enc_weights.py
!metal/assets/README.md

# diarization benchmark data (large, not versioned)
metal/bench/*.wav
metal/bench/*.rttm
metal/bench/md-eval.pl
metal/bench/*.bin
metal/bench/*.log
metal/bench/*.onnx
metal/assets/resnet34_diar.bin
metal/assets/kaldi_melbank.bin
