# ── OS / editor junk ─────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ── Build outputs ────────────────────────────────────────────────
build/
out/
zig-cache/
zig-out/
.zig-cache/
*.o
*.obj
*.exe
*.pdb
*.dSYM/

# ── Metal artifacts ──────────────────────────────────────────────
*.metallib
*.air

# ── CUDA build artifacts ─────────────────────────────────────────
*.cubin
*.ptxas

# ── Model weights / generated data (large, re-creatable) ─────────
# Source stays tracked: *.zig, kernels/*.ptx, metal/kernels/*.metal.
# Binary model data + generated assets are NOT committed.
*.safetensors
*.bin
*.wav
*.npz
*.tar.gz

# ── Model-asset folder: keep only generator scripts + docs ───────
engine/metal/assets/*
!engine/metal/assets/gen_assets.py
!engine/metal/assets/export_enc_weights.py
!engine/metal/assets/README.md

# diarization benchmark data (large, not versioned)
engine/metal/bench/*.wav
engine/metal/bench/*.rttm
engine/metal/bench/md-eval.pl
engine/metal/bench/*.bin
engine/metal/bench/*.log
engine/metal/bench/*.onnx
engine/metal/assets/resnet34_diar.bin
engine/metal/assets/kaldi_melbank.bin
engine/metal/bench/__pycache__/

# macOS app build artifacts
apps/macos/build/
apps/macos/.build/
apps/macos/*.xcodeproj/xcuserdata/
apps/macos/DerivedData/
*.dmg
engine/metal/bench/wer_runs/
engine/metal/bench/runs/*
!engine/metal/bench/runs/README.md
